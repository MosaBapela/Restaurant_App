EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Payment configuration
# Mode: 'stub' or 'stripe'
EXPO_PUBLIC_PAYMENT_MODE=stub
EXPO_PUBLIC_PAYMENT_STUB_URL=http://localhost:4242/pay
EXPO_PUBLIC_PAYMENT_STUB_KEY=dev_stub_key

# For Stripe (server URL is the secure server that creates PaymentIntents)
EXPO_PUBLIC_STRIPE_SERVER_URL=http://localhost:4242
STRIPE_PUBLISHABLE_KEY=
STRIPE_SERVER_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Analytics/measurementId (only used if you enable analytics)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: Stripe (if you integrate later)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SERVER_URL=

# NOTES:
# 1) Copy this file to `.env` (or use a local secret manager) and fill the values
# 2) Do NOT commit your real `.env` to source control